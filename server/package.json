    "deploy": "node --env-file-if-exists=../.env --experimental-strip-types --disable-warning=ExperimentalWarning scripts/deploy.ts",
    "import:history": "node --env-file-if-exists=../.env --experimental-strip-types --disable-warning=ExperimentalWarning scripts/import-history.ts",
